{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recap.local/schemas/v1/scenes.json",
  "title": "SceneCollection",
  "description": "Scenes of one analysis revision; geometry is local, labels are provider-supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_revision_id", "provenance", "scenes"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_revision_id": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/Provenance"},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Scene"}}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "producer", "producer_version", "schema_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "prompt_id": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]}
      }
    },
    "Scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "analysis_revision_id",
        "ordinal",
        "start_ms",
        "end_ms",
        "shot_ids",
        "character_ids",
        "location",
        "summary",
        "confidence",
        "provenance"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "shot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "character_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "location": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"$ref": "#/$defs/Provenance"}
      }
    }
  }
}
