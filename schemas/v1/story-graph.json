{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recap.local/schemas/v1/story-graph.json",
  "title": "StoryGraph",
  "description": "Immutable typed causal graph over the events of one analysis revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_revision_id",
    "event_ids",
    "events",
    "plots",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_revision_id": {"type": "string", "minLength": 1},
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Event"}},
    "plots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Plot"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/StoryEdge"}},
    "provenance": {"$ref": "#/$defs/Provenance"}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "producer", "producer_version", "schema_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "prompt_id": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]}
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "scene_id",
        "analysis_revision_id",
        "ordinal",
        "start_ms",
        "end_ms",
        "character_ids",
        "action",
        "cause",
        "consequence",
        "importance",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "character_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "action": {"type": "string", "minLength": 1},
        "cause": {"type": "string"},
        "consequence": {"type": "string"},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "Plot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "analysis_revision_id",
        "ordinal",
        "title",
        "summary",
        "importance",
        "event_ids"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "StoryEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "analysis_revision_id",
        "from_event_id",
        "to_event_id",
        "relation",
        "confidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "from_event_id": {"type": "string", "minLength": 1},
        "to_event_id": {"type": "string", "minLength": 1},
        "relation": {
          "enum": ["CAUSE", "EFFECT", "SETUP", "PAYOFF", "REVEAL", "REACTION", "CONSEQUENCE"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
