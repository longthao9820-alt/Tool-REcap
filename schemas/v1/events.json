{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recap.local/schemas/v1/events.json",
  "title": "EventCollection",
  "description": "Characters, atomic events and their authoritative evidence for one analysis revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_revision_id",
    "provenance",
    "characters",
    "events",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_revision_id": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/Provenance"},
    "characters": {"type": "array", "items": {"$ref": "#/$defs/Character"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Event"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/EvidenceItem"}}
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "producer", "producer_version", "schema_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "prompt_id": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]}
      }
    },
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "analysis_revision_id", "canonical_name", "status", "aliases", "refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "canonical_name": {"type": "string", "minLength": 1},
        "status": {"enum": ["RESOLVED", "UNKNOWN"]},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "scene_id",
        "analysis_revision_id",
        "ordinal",
        "start_ms",
        "end_ms",
        "character_ids",
        "action",
        "cause",
        "consequence",
        "importance",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "character_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "action": {"type": "string", "minLength": 1},
        "cause": {"type": "string"},
        "consequence": {"type": "string"},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event_id",
        "analysis_revision_id",
        "type",
        "start_ms",
        "end_ms",
        "transcript_id",
        "artifact_id",
        "confidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "analysis_revision_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["TRANSCRIPT", "VISUAL", "TIME_RANGE"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "transcript_id": {"type": ["string", "null"]},
        "artifact_id": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
