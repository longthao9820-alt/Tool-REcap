{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-recap.local/schemas/v1/transcript.json",
  "title": "Transcript",
  "description": "Timestamped speech for one analysis revision, bound to the STT audio bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "duration_ms",
    "audio_sha256",
    "provenance",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "language": {"type": "string", "minLength": 1},
    "duration_ms": {"type": "integer", "exclusiveMinimum": 0},
    "audio_sha256": {"$ref": "#/$defs/Sha256"},
    "provenance": {"$ref": "#/$defs/Provenance"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/TranscriptSegment"}
    }
  },
  "$defs": {
    "Sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "producer", "producer_version", "schema_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "prompt_id": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]}
      }
    },
    "Word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start_ms", "end_ms"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "TranscriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "start_ms",
        "end_ms",
        "speaker_id",
        "text",
        "confidence",
        "words"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "speaker_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "words": {"type": "array", "items": {"$ref": "#/$defs/Word"}}
      }
    }
  }
}
