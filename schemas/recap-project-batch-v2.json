{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recap Studio JSON v2",
  "type": "object",
  "required": ["schema_version", "project_type", "project_name", "episodes"],
  "properties": {
    "schema_version": {"enum": ["2.0", "2.1", "2.2"]},
    "project_type": {"enum": ["SINGLE_EPISODE", "SEASON_BATCH"]},
    "project_name": {"type": "string", "minLength": 1},
    "media_root_hint": {"type": "string"},
    "output_subdirectory": {"type": "string", "default": "recaps_da_render"},
    "content_type": {"enum": ["US_TV_SHOW", "DE_GERMAN_SOAP", "FEATURE_FILM", "BODYCAM", "OTHER"]},
    "recap_language": {"enum": ["en-US", "en-GB"]},
    "render_policy": {"$ref": "#/$defs/render_policy"},
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/episode"}
    }
  },
  "$defs": {
    "render_policy": {
      "type": "object",
      "properties": {
        "aspect_ratio_policy": {"const": "preserve_source"},
        "voice_speed": {"const": 1.0},
        "video_speed_min": {"type": "number", "minimum": 0.1, "maximum": 1.0},
        "video_speed_max": {"type": "number", "minimum": 1.0, "maximum": 4.0},
        "video_speed_absolute_min": {"type": "number", "minimum": 0.1, "maximum": 1.0},
        "video_speed_absolute_max": {"type": "number", "minimum": 1.0, "maximum": 4.0},
        "allow_frame_freeze": {"type": "boolean"},
        "allow_clip_repeat": {"type": "boolean"},
        "allow_unlisted_clips": {"type": "boolean"}
      }
    },
    "episode": {
      "type": "object",
      "required": ["episode_id", "source_file", "recap_mode", "recap_language", "source_rights", "outputs"],
      "properties": {
        "episode_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "title": {"type": "string"},
        "source_file": {"type": "string", "minLength": 1},
        "recap_mode": {"enum": ["FULL_EPISODE", "MAIN_STORIES"]},
        "available_recap_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["FULL_EPISODE", "MAIN_STORIES"]}
        },
        "recap_language": {"enum": ["en-US", "en-GB"]},
        "source_rights": {"$ref": "#/$defs/source_rights"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}
      }
    },
    "output": {
      "type": "object",
      "required": [
        "render_id",
        "type",
        "title",
        "file_name",
        "narration_subtitle_file",
        "original_subtitle_file",
        "segments"
      ],
      "properties": {
        "render_id": {"type": "string"},
        "type": {"enum": ["FULL_RECAP", "MAIN_STORY", "HIGHLIGHT"]},
        "title": {"type": "string"},
        "file_name": {"type": "string", "pattern": "^[^<>:\\\"/\\\\|?*]+\\.mp4$"},
        "narration_subtitle_file": {"type": "string", "pattern": "^[^<>:\\\"/\\\\|?*]+\\.narration\\.srt$"},
        "original_subtitle_file": {"type": "string", "pattern": "^[^<>:\\\"/\\\\|?*]+\\.original\\.srt$"},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "segment_id",
        "order",
        "segment_type",
        "purpose",
        "editorial_value",
        "narration_text",
        "estimated_voice_duration_ms",
        "source_visual_duration_ms",
        "recommended_visual_speed",
        "audio_policy",
        "preserve_original_audio",
        "subtitle",
        "source_clips"
      ],
      "properties": {
        "segment_id": {"type": "string"},
        "order": {"type": "integer", "minimum": 1},
        "segment_type": {"enum": ["narration", "original_dialogue"]},
        "purpose": {
          "enum": [
            "ORIGINAL_HOOK",
            "CONTEXT",
            "CAUSAL_ANALYSIS",
            "CHARACTER_ANALYSIS",
            "RELATIONSHIP_CHANGE",
            "HIDDEN_DETAIL",
            "COMPARISON",
            "CRITIQUE",
            "INTERPRETATION",
            "CONSEQUENCE",
            "THEMATIC_INSIGHT",
            "ORIGINAL_CONCLUSION",
            "ORIGINAL_DIALOGUE_EVIDENCE"
          ]
        },
        "editorial_value": {"type": "string", "minLength": 1},
        "narration_text": {"type": ["string", "null"]},
        "estimated_voice_duration_ms": {"type": "integer", "minimum": 0},
        "source_visual_duration_ms": {"type": "integer", "minimum": 1},
        "recommended_visual_speed": {"type": "number", "exclusiveMinimum": 0},
        "audio_policy": {"enum": ["mute", "preserve"]},
        "original_audio": {"enum": ["mute", "preserve"]},
        "preserve_original_audio": {"type": "boolean"},
        "subtitle": {"type": "boolean"},
        "subtitle_source": {"enum": ["narration", "original_dialogue"]},
        "original_dialogue_text": {"type": "string"},
        "source_clips": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clip"}}
      }
    },
    "clip": {
      "type": "object",
      "required": ["clip_id", "start_ms", "end_ms", "order"],
      "properties": {
        "clip_id": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "order": {"type": "integer", "minimum": 1},
        "scene_description": {"type": "string"},
        "characters": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_rights": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["UNVERIFIED", "OWNED", "LICENSED", "FIRST_PUBLICATION_RIGHTS"]},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
